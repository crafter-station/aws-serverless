---
/*
  El "diagrama" de single-table design es la tabla misma. Dibujarla en SVG la
  haría más bonita y menos legible: aquí lo que enseña es ver los tipos de
  entidad conviviendo bajo la misma clave.
*/
interface Fila {
  pk: string;
  sk: string;
  tipo: 'perfil' | 'pedido' | 'direccion' | 'linea';
  atributos: string;
}

interface Props {
  filas: Fila[];
  /** Resalta la colección de elementos que devuelve una sola Query. */
  resaltar?: string;
  pie?: string;
}
const { filas, resaltar, pie } = Astro.props;

const NOMBRE = {
  perfil: 'Perfil',
  pedido: 'Pedido',
  direccion: 'Dirección',
  linea: 'Línea',
} as const;
---

<figure class="tu">
  <div class="tu__caja">
    <table>
      <thead>
        <tr>
          <th>PK</th>
          <th>SK</th>
          <th>Tipo</th>
          <th>Atributos</th>
        </tr>
      </thead>
      <tbody>
        {filas.map((f) => (
          <tr class={resaltar && f.pk === resaltar ? 'tu--dentro' : undefined}>
            <td class="tu__clave">{f.pk}</td>
            <td class="tu__clave">{f.sk}</td>
            <td><span class={`tu__tipo tu__tipo--${f.tipo}`}>{NOMBRE[f.tipo]}</span></td>
            <td class="tu__attr">{f.atributos}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  {pie && <figcaption set:html={pie} />}
</figure>

<style>
  .tu { margin: 2.5rem 0; }
  .tu__caja {
    overflow-x: auto;
    background: var(--papel-alto);
    border: 1px solid var(--linea);
    border-radius: var(--radio);
  }
  /* Anula el margen que .prosa table aplica desde los estilos globales. */
  .tu__caja table {
    margin: 0;
    width: 100%; min-width: 34rem; border-collapse: collapse;
    font-family: var(--sans); font-size: .875rem;
  }
  th, td { padding: .55rem .75rem; text-align: left; border-bottom: 1px solid var(--linea); }
  th {
    font-size: .6875rem; font-weight: 700; letter-spacing: .07em;
    text-transform: uppercase; color: var(--tinta-tenue);
    background: var(--papel-hondo);
  }
  tbody tr:last-child td { border-bottom: 0; }

  /* La colección de elementos: lo que una sola Query devuelve de golpe. */
  .tu--dentro td { background: var(--acento-suave); }
  .tu--dentro .tu__clave:first-child { box-shadow: inset 3px 0 0 var(--acento); }

  .tu__clave { font-family: var(--mono); font-size: .8125rem; white-space: nowrap; }
  .tu__attr { color: var(--tinta-tenue); font-size: .8125rem; }

  .tu__tipo {
    display: inline-block; padding: .1rem .45rem; border-radius: 3px;
    font-size: .6875rem; font-weight: 700; white-space: nowrap;
  }
  .tu__tipo--perfil    { background: #e6eef8; color: #1f4b80; }
  .tu__tipo--pedido    { background: #fdf0e7; color: #a03a08; }
  .tu__tipo--direccion { background: #eaf3ec; color: #1f6b3c; }
  .tu__tipo--linea     { background: #f3ecf6; color: #5b3272; }

  figcaption {
    margin: .75rem 0 0; font-family: var(--sans);
    font-size: .8125rem; line-height: 1.5; color: var(--tinta-tenue);
  }
  figcaption :global(strong) { color: var(--tinta-suave); font-weight: 600; }
</style>
