---
/*
  "Copiar página": se lleva la ficha entera en markdown al portapapeles.

  No mete el texto en el HTML: lo pide a la URL `.md` que ya existe. Duplicar
  la ficha dentro de su propia página engordaría cada documento al doble por
  una función que casi nadie usa.
*/
interface Props {
  /** Ruta al markdown de esta misma ficha. */
  href: string;
}
const { href } = Astro.props;
---

<div class="acciones">
  <button class="accion accion--copiar" type="button" data-md={href}>
    <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
      <rect x="5.25" y="1.75" width="9" height="9" rx="1.5" />
      <path d="M10.75 13.25v0.5a1.5 1.5 0 0 1-1.5 1.5h-6a1.5 1.5 0 0 1-1.5-1.5v-6a1.5 1.5 0 0 1 1.5-1.5h0.5" />
    </svg>
    <span class="accion__texto">Copiar página</span>
  </button>
  <a class="accion" href={href}>Ver .md</a>
</div>

<script>
  const ORIGINAL = 'Copiar página';

  document.querySelectorAll<HTMLButtonElement>('.accion--copiar').forEach((boton) => {
    const rotulo = boton.querySelector('.accion__texto')!;
    let temporizador: number | undefined;

    boton.addEventListener('click', async () => {
      const url = boton.dataset.md;
      if (!url) return;

      try {
        const md = await fetch(url).then((r) => r.text());
        await navigator.clipboard.writeText(md);
        rotulo.textContent = 'Copiado';
        boton.classList.add('accion--hecho');
      } catch {
        /* Sin portapapeles —http, permisos denegados— al menos que vea el texto. */
        window.open(url, '_blank', 'noopener');
        rotulo.textContent = 'Abierto aparte';
      }

      clearTimeout(temporizador);
      temporizador = window.setTimeout(() => {
        rotulo.textContent = ORIGINAL;
        boton.classList.remove('accion--hecho');
      }, 2000);
    });
  });
</script>

<style>
  .acciones { display: flex; gap: .5rem; flex-wrap: wrap; }

  .accion {
    display: inline-flex; align-items: center; gap: .4rem;
    padding: .3rem .7rem;
    font-family: var(--sans); font-size: .75rem; font-weight: 600;
    letter-spacing: .02em;
    color: var(--tinta-tenue); text-decoration: none;
    background: var(--papel-alto);
    border: 1px solid var(--linea); border-radius: 999px;
    cursor: pointer;
    transition: color .12s, border-color .12s;
  }
  .accion:hover { color: var(--acento); border-color: var(--acento); }

  .accion svg {
    fill: none; stroke: currentColor; stroke-width: 1.4;
    stroke-linecap: round; stroke-linejoin: round;
  }

  .accion--hecho, .accion--hecho:hover { color: var(--bien); border-color: var(--bien); }
</style>
