---
/** El punto donde algo se rompe. Se pone encima de una flecha o un nodo. */
interface Props { x: number; y: number; r?: number; }
const { x, y, r = 9 } = Astro.props;
---

<g class="cruz">
  <circle cx={x} cy={y} r={r} class="cruz__disco" />
  <path d={`M${x - r * 0.4},${y - r * 0.4} L${x + r * 0.4},${y + r * 0.4}
            M${x + r * 0.4},${y - r * 0.4} L${x - r * 0.4},${y + r * 0.4}`} class="cruz__aspa" />
</g>

<style>
  .cruz__disco { fill: var(--peligro); }
  .cruz__aspa { stroke: #fff; stroke-width: 2; stroke-linecap: round; fill: none; }
</style>
