---
import '../styles/global.css';
import Defs from '../components/diagrama/Defs.astro';
import FilaServicios from '../components/FilaServicios.astro';

interface Props {
  frontmatter: {
    titulo: string;
    alias: string;
    familia: string;
    dificultad: 1 | 2 | 3;
    intencion: string;
    servicios: { icono: string; nombre: string }[];
    verificado_en: string;
  };
}
const { titulo, alias, familia, dificultad, intencion, servicios, verificado_en } =
  Astro.props.frontmatter;

const escalones = ['Directo', 'Intermedio', 'Delicado'];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo} · aws.crafter.run</title>
    <meta name="description" content={intencion} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&family=JetBrains+Mono:wght@400;500&display=swap"
    />
  </head>

  <body>
    <Defs />

    <header class="barra">
      <a class="barra__marca" href="/">aws<span>.crafter.run</span></a>
      <nav class="barra__nav">
        <a href="/servicios">Servicios</a>
        <a href="/patrones" aria-current="page">Patrones</a>
      </nav>
    </header>

    <main>
      <div class="cabecera">
        <p class="cabecera__familia">{familia}</p>
        <h1 class="cabecera__titulo">{titulo}</h1>
        <p class="cabecera__alias">También llamado <em>{alias}</em></p>
        <p class="cabecera__intencion">{intencion}</p>

        <div class="cabecera__meta">
          <FilaServicios servicios={servicios} />
          <div class="cabecera__sellos">
            <span class="sello">{escalones[dificultad - 1]}</span>
            <span class="sello sello--fecha">
              Verificado el <time datetime={verificado_en}>{verificado_en}</time>
            </span>
          </div>
        </div>
      </div>

      <article class="prosa">
        <slot />
      </article>
    </main>

    <footer class="pie">
      <p>
        Los iconos de arquitectura son © Amazon Web Services, Inc., usados sin
        modificación bajo los
        <a href="https://aws.amazon.com/architecture/icons/">términos de AWS</a>.
      </p>
    </footer>

    <style>
      /* ── Chrome ─────────────────────────────────────────────── */
      .barra {
        display: flex; align-items: center; justify-content: space-between;
        gap: 1rem; flex-wrap: wrap;
        max-width: 60rem; margin: 0 auto; padding: 1.25rem 1.5rem;
        border-bottom: 1px solid var(--linea);
      }
      .barra__marca {
        font-weight: 700; font-size: 1rem; letter-spacing: -.01em;
        color: var(--tinta); text-decoration: none;
      }
      .barra__marca span { color: var(--tinta-tenue); font-weight: 500; }
      .barra__nav { display: flex; gap: 1.25rem; font-size: .875rem; }
      .barra__nav a { color: var(--tinta-suave); text-decoration: none; }
      .barra__nav a:hover { color: var(--acento); }
      .barra__nav a[aria-current] { color: var(--tinta); font-weight: 600; }

      main { max-width: 60rem; margin: 0 auto; padding: 0 1.5rem; }

      /* ── Cabecera de la ficha ───────────────────────────────── */
      .cabecera { padding: 3.5rem 0 2rem; border-bottom: 1px solid var(--linea); }
      .cabecera__familia {
        margin: 0 0 .75rem; font-size: .75rem; font-weight: 700;
        letter-spacing: .09em; text-transform: uppercase; color: var(--acento);
      }
      .cabecera__titulo {
        margin: 0; font-size: clamp(2.25rem, 6vw, 3.25rem); line-height: 1.08;
        font-weight: 700; letter-spacing: -.025em;
      }
      .cabecera__alias {
        margin: .625rem 0 0; font-size: .9375rem; color: var(--tinta-tenue);
      }
      .cabecera__alias em { font-style: normal; font-weight: 600; color: var(--tinta-suave); }
      .cabecera__intencion {
        max-width: 36rem; margin: 1.5rem 0 0;
        font-family: var(--serif); font-size: 1.3125rem; line-height: 1.55;
        color: var(--tinta-suave);
      }
      .cabecera__meta {
        display: flex; justify-content: space-between; align-items: flex-end;
        gap: 1rem 2rem; flex-wrap: wrap; margin-top: 2rem;
      }
      .cabecera__sellos { display: flex; gap: .5rem; flex-wrap: wrap; }
      .sello {
        padding: .25rem .625rem; border: 1px solid var(--linea);
        border-radius: 999px; font-size: .75rem; color: var(--tinta-tenue);
        background: var(--papel-alto);
      }
      .sello--fecha time { font-variant-numeric: tabular-nums; }

      /* ── Prosa ──────────────────────────────────────────────── */
      .prosa { max-width: var(--medida); padding: 1rem 0 5rem; }
      .prosa :global(p),
      .prosa :global(li) {
        font-family: var(--serif); font-size: 1.125rem; line-height: 1.7;
      }
      .prosa :global(h2) {
        margin: 3.5rem 0 1rem; padding-top: 1.75rem;
        border-top: 1px solid var(--linea);
        font-size: 1.625rem; font-weight: 700; letter-spacing: -.015em; line-height: 1.25;
      }
      .prosa :global(h3) {
        margin: 2.5rem 0 .75rem;
        font-size: 1.1875rem; font-weight: 600; letter-spacing: -.01em;
      }
      .prosa :global(strong) { font-weight: 600; color: var(--tinta); }
      .prosa :global(ul), .prosa :global(ol) { padding-left: 1.35rem; }
      .prosa :global(li) { margin: .4rem 0; }
      .prosa :global(li::marker) { color: var(--tinta-tenue); }

      .prosa :global(code) {
        font-family: var(--mono); font-size: .875em;
        background: var(--papel-hondo); padding: .1em .35em;
        border-radius: 3px; color: var(--tinta);
      }
      .prosa :global(pre) {
        margin: 1.75rem 0; padding: 1.125rem 1.25rem;
        border: 1px solid var(--linea); border-radius: var(--radio);
        overflow-x: auto; font-size: .875rem; line-height: 1.6;
      }
      .prosa :global(pre code) { background: none; padding: 0; font-size: inherit; }

      .prosa :global(table) {
        width: 100%; margin: 1.75rem 0; border-collapse: collapse;
        font-family: var(--sans); font-size: .9375rem;
      }
      .prosa :global(th), .prosa :global(td) {
        padding: .625rem .75rem; text-align: left;
        border-bottom: 1px solid var(--linea); vertical-align: top;
      }
      .prosa :global(th) {
        font-size: .75rem; font-weight: 700; letter-spacing: .06em;
        text-transform: uppercase; color: var(--tinta-tenue);
      }

      .prosa :global(hr) { margin: 3rem 0; border: 0; border-top: 1px solid var(--linea); }

      .pie {
        max-width: 60rem; margin: 0 auto; padding: 2rem 1.5rem 3rem;
        border-top: 1px solid var(--linea);
        font-size: .8125rem; color: var(--tinta-tenue);
      }
      .pie p { margin: 0; max-width: 44rem; }
    </style>
  </body>
</html>
